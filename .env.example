# Copy this file to .env and fill in real values. Never commit .env.

# Postgres
POSTGRES_USER=carrental
POSTGRES_PASSWORD=carrental_dev_password
POSTGRES_DB=carrental

# Go API (host port 8090 to avoid clashing with other local projects)
API_PORT=8090
DB_URL="host=localhost port=5434 user=carrental password=carrental_dev_password dbname=carrental sslmode=disable"
JWT_SECRET=change-me-to-a-long-random-string

# Seeded admin account (created on first startup)
ADMIN_EMAIL=admin@carrental.local
ADMIN_PASSWORD=admin123

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost:8090
