# Copy to .env and fill in the blanks. Never commit .env.
#
# The blanks below are deliberate. This repository is public, so any value
# written here would be known to everyone — the API refuses to start on a
# placeholder secret rather than run with one.
#
# Generate each secret with:
#     openssl rand -base64 32

# Postgres
POSTGRES_USER=carrental
POSTGRES_PASSWORD=
POSTGRES_DB=carrental

# Go API (host port 8090 to avoid clashing with other local projects).
# DB_URL must carry the same password as POSTGRES_PASSWORD above.
API_PORT=8090
DB_URL="host=localhost port=5434 user=carrental password= dbname=carrental sslmode=disable"

# Signs session cookies. Anyone holding this can mint an admin session,
# so it must be long, random, and never shared. Minimum 24 characters.
JWT_SECRET=

# Seeded admin account, created on first startup. Minimum 8 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Origin the browser loads the site from — allowed through CORS by the API.
WEB_ORIGIN=http://localhost:3000

# Frontend. NUXT_PUBLIC_API_BASE is browser-facing; under Docker Compose the
# Nuxt server additionally uses NUXT_API_INTERNAL=http://api:8080 for SSR.
NUXT_PUBLIC_API_BASE=http://localhost:8090
