# Replace example.com with your real domain.
# Caddy fetches and renews the HTTPS certificate automatically.
example.com {
	# Go API and uploaded photos
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /uploads/* {
		reverse_proxy api:8080
	}

	# Everything else goes to the Nuxt server
	handle {
		reverse_proxy web:3000
	}
}
